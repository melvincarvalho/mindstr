    "test:browser": "node --test \"test/browser/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melvincarvalho/mindstr.git"
  },
  "keywords": [
    "nostr",
    "mindstr"
  ],
  "author": "Melvin Carvalho",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/melvincarvalho/mindstr/issues"
  },
  "homepage": "https://github.com/melvincarvalho/mindstr#readme",
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22"
  }
}
